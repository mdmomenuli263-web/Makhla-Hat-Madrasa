/* =====================================================
   GALLERY
===================================================== */

function loadGallery() {

    const container =
        document.querySelector(
            "#gallery .gallery"
        );

    if (!container) return;


    container.innerHTML = "";


    const gallery =
        websiteData.gallery || [];


    if (gallery.length === 0) {

        container.innerHTML =
            "<p>গ্যালারিতে এখনো কোনো ছবি যোগ করা হয়নি।</p>";

        return;

    }


    gallery.forEach(
        function(item) {

            const image =
                document.createElement(
                    "img"
                );


            image.src =
                item.image;


            image.alt =
                item.title || "মাদ্রাসা";


            image.loading =
                "lazy";


            container.appendChild(
                image
            );

        }
    );

}


