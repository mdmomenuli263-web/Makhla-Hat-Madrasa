    const container =
        document.querySelector(
            "#education .cards"
        );

    if (!container) return;


    container.innerHTML = "";


    const education =
        websiteData.education || [];


    education.forEach(
        function(item) {

            const card =
                document.createElement(
                    "div"
                );

            card.className =
