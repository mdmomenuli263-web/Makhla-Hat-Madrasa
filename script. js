/* =====================================================
   MERGE DATA
===================================================== */

function getWebsiteData() {

    try {

        const saved =
            localStorage.getItem(STORAGE_KEY);

        if (!saved) {

            return DEFAULT_DATA;

        }

        const savedData =
            JSON.parse(saved);

        return {

            ...DEFAULT_DATA,

            ...savedData

        };

    }

    catch (error) {

        console.error(
            "Data loading error:",
            error
        );

        return DEFAULT_DATA;

    }

}


/* =====================================================
   CURRENT DATA
===================================================== */

const websiteData =
    getWebsiteData();


/* =====================================================
   SAFE TEXT
===================================================== */

function setText(
    id,
    value
) {

    const element =
        document.getElementById(id);

    if (!element) return;

    element.textContent =
        value || "";

}


/* =====================================================
   SAFE HTML
===================================================== */

function setHTML(
    id,
    value
) {

    const element =
        document.getElementById(id);

    if (!element) return;

    element.innerHTML =
        value || "";

}


