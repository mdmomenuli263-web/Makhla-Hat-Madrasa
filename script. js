/* =====================================================
   NOTICES
===================================================== */

function loadNotices() {

    const container =
        document.getElementById(
            "notice"
        );

    if (!container) return;


    container.innerHTML = "";


    const notices =
        websiteData.notices || [];


    if (notices.length === 0) {

        container.innerHTML =
            "<p>বর্তমানে কোনো নোটিশ নেই।</p>";

        return;

    }


    notices.forEach(
        function(notice) {

            const div =
                document.createElement(
                    "div"
                );

            div.className =
                "notice";


            div.innerHTML = `

                <strong>
                    📢 ${escapeHTML(
                        notice.title
                    )}
                </strong>

                <small>
                    ${escapeHTML(
                        notice.date
                    )}
                </small>

            `;


            container.appendChild(
                div
            );

        }
    );

}


/* =====================================================
   EDUCATION
===================================================== */

