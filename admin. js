/* =====================================================
   LOAD DATA
===================================================== */

function loadAdminData() {

    try {

        const saved =
            localStorage.getItem(
                ADMIN_STORAGE_KEY
            );

        if (!saved) {

            return JSON.parse(
                JSON.stringify(
                    ADMIN_DEFAULT_DATA
                )
            );

        }

        return {

            ...ADMIN_DEFAULT_DATA,

            ...JSON.parse(saved)

        };

    }

    catch (error) {

        console.error(error);

        return JSON.parse(
            JSON.stringify(
                ADMIN_DEFAULT_DATA
            )
        );

    }

}


let adminData =
    loadAdminData();


/* =====================================================
   LOGIN
===================================================== */

function adminLogin() {

    const passwordInput =
        document.getElementById(
            "adminPassword"
        );

    if (!passwordInput) return;


    const password =
        passwordInput.value;


    if (password === ADMIN_PASSWORD) {

        localStorage.setItem(
            "adminLoggedIn",
            "true"
        );


        showAdminPanel();

    }

    else {

        alert(
            "❌ ভুল পাসওয়ার্ড!"
        );

    }

}


